# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# rustc will dump stack traces when hitting an internal compiler error to PWD
rustc-ice-*.txt

# VIM
*~
*.swp
*.swo

# TMP files
tmp

# Local agent sessions and cloud credentials; publish .agents/skills intentionally.
/.codex/
/.aws/

# Local environment, deployment state and private exports.
.env
.env.*
!.env.example
/state/
/backups/
/private/
/exports/
**/state.json
**/admin.json
*.key
*.pem
*.p12
*.pfx
*.log

# Local AI assistant configuration, sessions and indexes.
# Keep shared .agents/skills and its license/provenance files publishable.
/.claude/
/.claude.json
/CLAUDE.local.md
/.cursor/
/.opencode/
/.gemini/
/.continue/
/.goose/
/.aider*
/.windsurf/
/.cline/
/.roo/
/.kilocode/

